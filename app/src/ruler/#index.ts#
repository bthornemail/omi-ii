function bindWord256(
  monad: WORD64,
  offset: number,
  extent: number
): WORD256 {
  return binaryQuadraticProjection(
    monad,
    offset,
    extent
  );
}


function xorBindReference(
  word: WORD256,
  offset: number,
  extent: number,
  umask: UMASK
): INTEGER_REFERENCE {
