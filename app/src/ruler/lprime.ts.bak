// The pair is (60, 16)
    // Everything is triples rolling to the delta
const completeRoll = (omi: Uint8Array) => {
    let result = 0n;
    
    // Triple 1: Lifecycle
    result ^= Atomics.compareExchange(omi, 0, 2n, 1n);
    result ^= Atomics.compareExchange(omi, 1, 0n, 2n);
    result ^= Atomics.compareExchange(omi, 2, 1n, 0n);
    
    // Triple 2: Constraints
    result ^= Atomics.compareExchange(omi, 3, 7n, 5n);
    result ^= Atomics.compareExchange(omi, 5, 9n, 7n);
    result ^= Atomics.compareExchange(omi, 7, 3n, 9n);
    
    // Triple 3: Constraints
    result ^= Atomics.compareExchange(omi, 9, 5n, 3n);
    result ^= Atomics.compareExchange(omi, 4, 8n, 6n);
    result ^= Atomics.compareExchange(omi, 6, 4n, 8n);
    
    // Triple 4: Even Roll
    result ^= Atomics.compareExchange(omi, 8, 6n, 4n);
    result ^= Atomics.compareExchange(omi, 17, 17n, 0n);
    result ^= Atomics.compareExchange(omi, 17, 19n, 60n);
    
    return result; // The delta
};

// Unpack the pair
const unpack = (pair: bigint) => {
    const size = Number(pair >> 32n);
    const length = Number(pair & 0xFFFFFFFFn);
    return { size, length };
};
