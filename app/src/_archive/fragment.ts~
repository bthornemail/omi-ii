## Performance Optimization: Canvas Layout vs. Fragment Subtrees
When building interactive apps with WebSockets, you can combine HTML5 Canvas (for fluid animations) with a DocumentFragment (to batch UI updates, labels, or overlay control cards) without tanking the browser's frame rate.
## Efficient Dynamic UI Stacking (index.html)
This design uses raw text data over a WebSocket to calculate graphics on the canvas, while concurrently batching structural HTML text overlays using a DocumentFragment.

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Batch-Render Stream UI</title>
  <style>
    body { background: #111; color: #fff; font-family: sans-serif; display: flex; gap: 20px; padding: 20px; }
    canvas { background: #000; border: 2px solid #333; }
    #uiCardContainer { display: flex; flex-direction: column; gap: 10px; width: 250px; }
    .user-badge { background: #222; padding: 10px; border-left: 4px solid #00ffcc; border-radius: 4px; }
  </style>
</head>
<body>

  <!-- Dynamic Drawing Layer -->
  <canvas id="renderCanvas" width="400" height="300"></canvas>

  <!-- Live HTML Structural Layer -->
  <div id="uiCardContainer"></div>

  <!-- Reusable Template Component (Contains a DocumentFragment natively) -->
  <template id="badgeTemplate">
    <div class="user-badge">
      <strong class="name">Name</strong>
      <div class="status">Status</div>
    </div>
  </template>

  <script>
    const canvas = document.getElementById('renderCanvas');
    const ctx = canvas.getContext('2d');
    const container = document.getElementById('uiCardContainer');
    const template = document.getElementById('badgeTemplate');

    const ws = new WebSocket('ws://localhost:8080');

    ws.onmessage = (event) => {
      const [header, payload] = event.data.split(':');

      if (header === 'BATCH_UI_UPDATE') {
        // 1. Initialize an empty, lightweight DocumentFragment
        const fragment = document.createDocumentFragment();
        
        // Split our raw text command string into data pieces
        const structuralDataArray = payload.split('|'); // e.g., "Alice,Active|Bob,Idle"

        structuralDataArray.forEach(item => {
          const [name, status] = item.split(',');

          // 2. Clone the Template's internal DocumentFragment (.content)
          const clone = template.content.cloneNode(true);
          
          // Populate the offline node memory structures
          clone.querySelector('.name').textContent = name;
          clone.querySelector('.status').textContent = status;

          // 3. Assemble the subtree inside our temporary fragment
          fragment.appendChild(clone);
        });

        // 4. Wipe the old DOM entries and inject the new batch instantly.
        // This triggers exactly ONE browser layout reflow calculation!
        container.innerHTML = '';
        container.appendChild(fragment); // Nodes transfer smoothly, leaving 'fragment' empty.
      }
    };
  </script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ASCII Separator Canvas Trace</title>
  <style>
    body { background: #111; color: #fff; font-family: monospace; padding: 20px; }
    canvas { background: #000; border: 1px solid #333; margin-top: 10px; }
    #log { font-size: 11px; color: #888; max-height: 80px; overflow: hidden; }
  </style>
</head>
<body>

  <div id="log">Awaiting raw packet stream...</div>
  <canvas id="appCanvas" width="400" height="300"></canvas>

  <script>
    // Map identical string reference indicators matching backend definitions
    const FS = String.fromCharCode(0x1C);
    const GS = String.fromCharCode(0x1D);
    const RS = String.fromCharCode(0x1E);
    const US = String.fromCharCode(0x1F);

    const canvas = document.getElementById('appCanvas');
    const ctx = canvas.getContext('2d');
    const logDiv = document.getElementById('log');

    const ws = new WebSocket('ws://localhost:8080');

    ws.onmessage = (event) => {
      const rawPayload = event.data;

      // Layer 1: Split structural blocks via Group Separators (GS)
      const groups = rawPayload.split(GS);
      const traceGroup = groups[0];
      const renderGroup = groups[1];

      // Layer 2: Process Redundancy/Trace Group by Record Separators (RS)
      const traceRecords = traceGroup.split(RS);
      traceRecords.forEach(record => {
        const [metricType, filenameValue] = record.split(US);
        if (metricType === 'FILE_VERSION') {
          logDiv.textContent = `Syncing Target File Redundancy Reference URL: ${filenameValue}`;
        }
      });

      // Layer 3: Process Graphic Layout Group by Records and Units
      if (renderGroup) {
        const renderRecords = renderGroup.split(RS);
        renderRecords.forEach(record => {
          const units = record.split(US);
          const commandType = units[0];

          if (commandType === 'CANVAS_DRAW') {
            const targetX = parseInt(units[1], 10);
            const targetY = parseInt(units[2], 10);

            // Frame drawing execution pass
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#00ffaa';
            ctx.beginPath();
            ctx.arc(targetX, targetY, 12, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }
    };
  </script>
</body>
