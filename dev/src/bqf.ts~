export function original(
    x: bigint,
    y: bigint
): bigint {
    return (
        60n * x * x +
        16n * x * y +
        4n * y * y
    );
}

export function diagonalForm(
    x: bigint,
    y: bigint
): bigint {
    const diagonal = 2n * x + y;

    return (
        44n * x * x +
        4n * diagonal * diagonal
    );
}
