export function quadratic(
    x: bigint,
    y: bigint
) {
    const direct =
        60n * x * x +
        16n * x * y +
        4n * y * y;

    const diagonal = 2n * x + y;

    const resolved =
        44n * x * x +
        4n * diagonal * diagonal;

    return {
        x,
        y,
        diagonal,
        direct,
        resolved,
        equal: direct === resolved
    } as const;
}
