const G = Object.freeze({

    // ----- closure alphabet -----

    CLOSURE: /[(){}\[\]<>'`",]/g,

    // ----- character relations -----

    FRONT: /^[A-Za-z0-9:+]$/,
    BACK: /^[A-Za-z0-9.-]$/,

    INSIDE: /^[A-Za-z0-9_]$/,
    OUTSIDE: /^[^A-Za-z0-9_]$/,

    UP: /^[A-Z_]$/,
    DOWN: /^[a-z_]$/,

    // ----- positional relations -----

    LEFT: /^[0-9+-]\.[^0-9+-]$/,
    RIGHT: /^[^0-9+-]\.[0-9+-]$/,
    CENTER: /^[0-9]\.[0-9]$/,

    // ----- reflection relations -----

    DEFLECT: /^([^".]+):\1$/,
    REFLECT: /^([".]+):\1$/,
    INFLECT: /^([".]+):([".]+):\2:\1$/,

    // ----- higher forms -----

    AXIS:
        /^(\d\d)[A-Za-z_](\d\d):\2[0-9+-]\1$/,

    MNEMONIC:
        /^(\d\d)([A-Z_]?[a-z_]+)(\d\d):\3\2\1$/
});
