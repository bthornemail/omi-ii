import { Transform } from 'node:stream';
import { Buffer } from 'node:buffer';


// ============================================================
// REGEX VOCABULARY
// ============================================================

const INCLUDE =
    /[A-Za-z0-9_:+.\-(){}\[\]<>'`",]/;

const EXCLUDE =
    /[^A-Za-z0-9_:+.\-(){}\[\]<>'`",]/;

const ESCAPE =
    /\\(.)/;

const CLOSURE =
    /[(){}\[\]<>'`",]/;


// ------------------------------------------------------------
// ORIENTATION
// ------------------------------------------------------------

const FRONT = /[A-Za-z0-9:+]/;
const BACK = /[A-Za-z0-9.-]/;

const INSIDE = /[A-Za-z0-9_]/;
const OUTSIDE = /[^A-Za-z0-9_]/;

const UP = /[A-Z_]/;
const DOWN = /[a-z_]/;


// ------------------------------------------------------------
// POSITION
// ------------------------------------------------------------

const LEFT =
    /[0-9+-]\.[^0-9+-]/;

const RIGHT =
    /[^0-9+-]\.[0-9+-]/;

const CENTER =
    /[0-9]\.[0-9]/;


// ------------------------------------------------------------
// REFLECTION
// ------------------------------------------------------------

const DEFLECT =
    /([^".]+):\1/;

const REFLECT =
    /([".]+):\1/;

const INFLECT =
    /([".]+):([".]+):\2:\1/;


// ------------------------------------------------------------
// HIGHER FORMS
// ------------------------------------------------------------

const AXIS =
    /(\d\d)[A-Za-z_](\d\d):\2[0-9+-]\1/;

const MNEMONIC =
    /(\d\d)([A-Z_]?[a-z_]+)(\d\d):\3\2\1/;


// ============================================================
// FLAT TESTS
// ============================================================

const isIncluded = x => INCLUDE.test(x);
const isExcluded = x => EXCLUDE.test(x);
const isEscape = x => ESCAPE.test(x);
const isClosure = x => CLOSURE.test(x);

const isFront = x => FRONT.test(x);
const isBack = x => BACK.test(x);

const isInside = x => INSIDE.test(x);
const isOutside = x => OUTSIDE.test(x);

const isUp = x => UP.test(x);
const isDown = x => DOWN.test(x);

const isLeft = x => LEFT.test(x);
const isRight = x => RIGHT.test(x);
const isCenter = x => CENTER.test(x);

const isDeflect = x => DEFLECT.test(x);
const isReflect = x => REFLECT.test(x);
const isInflect = x => INFLECT.test(x);

const isAxis = x => AXIS.test(x);
const isMnemonic = x => MNEMONIC.test(x);


// ============================================================
// REGEX REDUCTION TRANSFORM
// ============================================================

class RegexReduction extends Transform {

    constructor(options = {}) {
        super(options);

        // Needed because "\" may occur at the end of one chunk
        // and its escaped character in the next.
        this.escape = false;
    }


    _transform(chunk, encoding, callback) {

        const input = Buffer.isBuffer(chunk)
            ? chunk
            : Buffer.from(chunk, encoding);

        const output = [];


        for (const byte of input) {

            const char = String.fromCharCode(byte);


            // ------------------------------------------------------
            // PREVIOUS BYTE WAS ESCAPE
            // ------------------------------------------------------

            if (this.escape) {

                // Preserve the escaped byte itself, but it is not
                // interpreted as syntax.

                output.push(byte);

                this.escape = false;
                continue;
            }


            // ------------------------------------------------------
            // ESCAPE / REDACTION
            // ------------------------------------------------------

            if (char === '\\') {

                // Do not emit "\".
                //
                // Instead mark the next byte as syntactically
                // redacted.

                this.escape = true;
                continue;
            }


            // ------------------------------------------------------
            // VOCABULARY REDUCTION
            // ------------------------------------------------------

            if (isIncluded(char)) {
                output.push(byte);
                continue;
            }


            // ------------------------------------------------------
            // EXCLUDED
            // ------------------------------------------------------

            // Anything outside the vocabulary is reduced away.
        }


        this.push(Buffer.from(output));

        callback();
    }


    _flush(callback) {

        // A final "\" without another byte has nothing to escape.
        //
        // Treat it as excluded/reduced rather than allowing state
        // to leak past the end of the stream.

        this.escape = false;

        callback();
    }
}


// ============================================================
// FACTORY
// ============================================================

function createRegexReduction(options) {
    return new RegexReduction(options);
}


// ============================================================
// EXPORT
// ============================================================

export {

    // Regex
    INCLUDE,
    EXCLUDE,
    ESCAPE,
    CLOSURE,

    FRONT,
    BACK,
    INSIDE,
    OUTSIDE,
    UP,
    DOWN,

    LEFT,
    RIGHT,
    CENTER,

    DEFLECT,
    REFLECT,
    INFLECT,

    AXIS,
    MNEMONIC,

    // Tests
    isIncluded,
    isExcluded,
    isEscape,
    isClosure,

    isFront,
    isBack,
    isInside,
    isOutside,

    isUp,
    isDown,

    isLeft,
    isRight,
    isCenter,

    isDeflect,
    isReflect,
    isInflect,

    isAxis,
    isMnemonic,

    // Stream
    RegexReduction,
    createRegexReduction
};
