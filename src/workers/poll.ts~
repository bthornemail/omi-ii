import http from "node:http";
import url from "node:url";
import poll from "./poll"
import events from "./events";

const port = 8000;

// SSE head
function sseStart(res) {
    res.writeHead(200, {
	'Content-Type': "text/event-stream",
	'Cache-Control': "no-cache",
	'Connection': "keep-alive"
    });
}
// SSE random number
function sseRandom(res) {
    res.write("data: " + (Math.floor(Math.random() * 1000) + 1) + "\n\n");
    setTimeout(() => sseRandom(res), Math.random() * 3000);
}
http.createServer(async (req, res) => {

    // get URI path
    const uri = url.parse(req.url).pathname ? url.parse(req.url).pathname : "/";;
    // return response
    switch (uri) {
	case "/random":
	    sseStart(res);
	    sseRandom(res);
	    break;
	case "/events":
	    events(req,res);
	    break;
	case "/poll":
	case "/":
	    poll(req,res);	    
    }

}).listen(port);

console.log(`server running: http://localhost:${port}\n\n`);
