export default function poll(req, res) {
    // Simulate sending updates from the server
    let counter = 0;
    const intervalId = setInterval(() => {
        counter++;
        const ip = req.socket.localAddress;
        const port = req.socket.localPort;
        console.log(`Message ${counter}: Your client IP address is ${ip} and your source port is ${port}.`);

        // Write the event stream format
        res.write(`event: poll\n`);
        res.write(`id: ${counter}\n`);
        res.write(`data: Message ${counter}: Your client IP address is ${ip} and your source port is ${port}.\n\n`);
    }, 2000);

    // When client closes connection, stop sending events
    req.on('close', () => {
        clearInterval(intervalId);
        res.end();
    });
}
