import { createContext, runInContext,Script,compileFunction } from 'node:vm';

const adder = `
function add(a, b) {
    return a + b + c;
}

add(1, 2);
`
async function * unfold(code:string = "return a+b+c;",context = {c:3},callback:string = add){
    createContext(context);
    const fn = compileFunction(code,["a","b"], {
	filename: "add",
	parsingContext: context
    });
    console.log(`fn: [${fn.toString()}]`);
    yield fn;
    
    const script = new Script(callback);
    const cacheWithoutAdd = script.createCachedData();
    // In `cacheWithoutAdd` the function `add()` is marked for full compilation
    // upon invocation.

    
    // const cacheWithAdd = script.createCachedData();
    // `cacheWithAdd` contains fully compiled function `add()`.
    
    yield ()=>script.runInContext(context);
    
